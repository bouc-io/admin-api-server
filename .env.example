# Server
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/admindb"

# Encryption key for API keys at rest (Phase 2+)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="<32-byte hex key>"

# Keycloak Admin API (Phase 4+)
KEYCLOAK_ADMIN_URL="https://authn.app.pik8s.internal"
KEYCLOAK_REALM="users"
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="<password>"
# Grant type for the Keycloak admin token: "password" or "client_credentials" (default: password)
KEYCLOAK_ADMIN_GRANT_TYPE="password"

# Downstream service URLs for health aggregation (Phase 3+)
AGENT_API_URL="https://agent.pik8s.internal"
MEMORY_API_URL="https://memory.pik8s.internal"
CHATBOT_API_URL="https://chatbot.pik8s.internal"
OLLAMA_URL="http://localhost:11434"

# SSL/TLS (set to true for dev/k8s with self-signed certs)
ALLOW_SELF_SIGNED_CERTS=true
